{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Argon2": {
    "MemoryKiB": 65536,
    "Iterations": 3,
    "Parallelism": 1,
    "SaltLength": 16,
    "HashLength": 32
  },
  "Auth": {
    "RefreshTokenLifetime": "14.00:00:00",
    "MinimumPasswordLength": 12,
    "RateLimit": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "Jwt": {
    "Issuer": "softwarefactory",
    "Audience": "softwarefactory-api",
    "AccessTokenLifetime": "00:15:00"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
