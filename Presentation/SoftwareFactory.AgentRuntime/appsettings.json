{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Jobs": {
    "Enabled": true,
    "PollInterval": "00:00:02",
    "Lease": "00:05:00",
    "MaxAttempts": 3,
    "RetryBaseDelay": "00:00:30",
    "RetryMaxDelay": "00:15:00"
  },
  "Llm": {
    "DefaultTier": "Medium",
    "Tasks": {
      "artifact_generation": "Large",
      "architecture_design": "Large",
      "context_interview": "Large",
      "rubric_evaluation": "Medium",
      "test_case_generation": "Medium",
      "validation": "Medium",
      "classification": "Small",
      "extraction": "Small",
      "indexing": "Small"
    },
    "Tiers": {
      "Large": {
        "Provider": "anthropic",
        "Model": "claude-sonnet-5",
        "MaxOutputTokens": 16000
      },
      "Medium": {
        "Provider": "anthropic",
        "Model": "claude-haiku-4-5",
        "MaxOutputTokens": 8000
      },
      "Small": {
        "Provider": "anthropic",
        "Model": "claude-haiku-4-5",
        "MaxOutputTokens": 2000
      }
    },
    "Models": {
      "claude-sonnet-5": {
        "InputPerMillion": 2.0,
        "OutputPerMillion": 10.0,
        "CacheReadPerMillion": 0.2,
        "CacheWritePerMillion": 2.5
      },
      "claude-haiku-4-5": {
        "InputPerMillion": 1.0,
        "OutputPerMillion": 5.0,
        "CacheReadPerMillion": 0.1,
        "CacheWritePerMillion": 1.25
      }
    },
    "Providers": {
      "anthropic": {
        "Kind": "Anthropic",
        "Timeout": "00:05:00"
      }
    },
    "Budget": {
      "MaxCostPerCall": 1.0,
      "MaxCostPerJob": 10.0
    }
  },
  "Jwt": {
    "Issuer": "softwarefactory",
    "Audience": "softwarefactory-api",
    "AccessTokenLifetime": "00:15:00"
  },
  "Argon2": {
    "MemoryKiB": 65536,
    "Iterations": 3,
    "Parallelism": 1,
    "SaltLength": 16,
    "HashLength": 32
  }
}
