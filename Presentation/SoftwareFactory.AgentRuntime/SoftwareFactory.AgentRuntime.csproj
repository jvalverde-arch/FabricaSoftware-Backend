<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Worker host (Microsoft Agent Framework): consumes jobs through the same Application services the Api uses. Composition root for DI.
       Hosted as a minimal web application so that /health can be probed by the orchestrator; it serves no business endpoints. -->

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.Agents.AI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Domain/SoftwareFactory.Domain/SoftwareFactory.Domain.csproj" />
    <ProjectReference Include="../../Application/SoftwareFactory.Application/SoftwareFactory.Application.csproj" />
    <ProjectReference Include="../../Infrastructure/SoftwareFactory.Infrastructure/SoftwareFactory.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hosting policy shared by both hosts; linked source keeps one copy of the rule instead of two that drift. -->
    <Compile Include="../Shared/HostConfiguration.cs" Link="Composition/HostConfiguration.cs" />
  </ItemGroup>

</Project>
