# SoftwareFactory Agent Runtime — multi-stage build (.NET 10)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore SoftwareFactory.sln
RUN dotnet publish Presentation/SoftwareFactory.AgentRuntime/SoftwareFactory.AgentRuntime.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
USER app
ENTRYPOINT ["dotnet", "SoftwareFactory.AgentRuntime.dll"]
