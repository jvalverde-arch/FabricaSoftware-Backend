<Project>

  <!-- Solution-wide build rules (estandar-backend.md §3): nullable, warnings-as-errors, strict analyzers. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Pinned on purpose: `latest-all` moves the rule set with every new SDK, so the same source can build here and
         fail inside a container image with a newer SDK. Raising this is a deliberate change, reviewed like any other. -->
    <AnalysisLevel>10.0-all</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!-- Documentation file is required for IDE0005 (unused usings) to run at build time; CS1591 (missing XML comment) is not enforced. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <!-- Excludes the real-endpoint tests from the default run; see tests.runsettings. -->
    <RunSettingsFilePath Condition="'$(RunSettingsFilePath)' == ''">$(MSBuildThisFileDirectory)tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <!-- Each production project exposes internals to its own test project (SoftwareFactory.X -> SoftwareFactory.X.Tests). -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
  </ItemGroup>

</Project>
