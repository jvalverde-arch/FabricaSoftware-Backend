{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.local/schemas/non_functional_requirement/v1",
  "title": "Requisito no funcional",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "statement"
  ],
  "properties": {
    "category": {
      "enum": [
        "performance",
        "security",
        "availability",
        "usability",
        "maintainability",
        "other"
      ],
      "description": "Categoría"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "description": "Exigencia"
    },
    "metric": {
      "type": "string",
      "minLength": 1,
      "description": "Cómo se mide"
    }
  }
}
