{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwarefactory.local/schemas/adr/v1",
  "title": "Decisión de arquitectura",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "decision",
    "consequences"
  ],
  "properties": {
    "context": {
      "type": "string",
      "minLength": 1,
      "description": "Contexto"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "description": "Decisión tomada"
    },
    "consequences": {
      "type": "string",
      "minLength": 1,
      "description": "Consecuencias"
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Alternativas consideradas"
    }
  }
}
